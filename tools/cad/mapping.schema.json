{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nettopologysuite.proofs:cad:mapping.schema.json",
  "title": "CAD source to carrier mapping",
  "description": "Year-0 rows from the CAD-to-GIS bridging table. claimId stays null until year 1. A null kind is a placement of other rows, not a geometry record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "kind", "egg", "linearizer", "claimId"],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["format", "entity"],
            "properties": {
              "format": { "type": "string", "minLength": 1 },
              "entity": { "type": "string", "minLength": 1 }
            }
          },
          "kind": { "type": ["string", "null"], "minLength": 1 },
          "egg": { "type": ["string", "null"], "minLength": 1 },
          "linearizer": { "type": ["string", "null"], "minLength": 1 },
          "claimId": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  }
}
