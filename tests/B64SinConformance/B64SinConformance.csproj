<Project Sdk="Microsoft.NET.Sdk">
  <!-- S3 conformance: the C# port of the proved binary64 sine (B64Sin.cs) is
       compared bit for bit with the Rocq-extracted oracle (oracle_bin B64_SIN).
       Constants are generated from the Coq literals (gen_constants.py). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
